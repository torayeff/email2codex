AGENTMAIL_API_KEY="MY_KEY"
AGENTMAIL_INBOX="email2codex@agentmail.to"
ALLOWED_EMAILS="agajan@robominder.ai"

# Default `codex exec` options for every run; an email's `codex ...` first line is appended after these.
CODEX_ARGS='--skip-git-repo-check --dangerously-bypass-approvals-and-sandbox -m gpt-6-luna -c model_reasoning_effort="max"'

# Environment variables Codex needs.
# Every variable in this file is passed on to Codex. When email2codex runs as a service,
# it does NOT see variables exported in your shell profile (~/.zshrc, ~/.bashrc), so put
# them here. Example: ~/.codex/config.toml has `env_key = "AZURE_OPENAI_API_KEY"`.
# AZURE_OPENAI_API_KEY="..."

# Optional
# CODEX_BIN="codex"
# CODEX_WORKDIR="/path/where/codex/works"   # default: current directory
